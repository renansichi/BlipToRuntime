      "id": "01a19f46-3b11-74cc-b33b-b11ee2ec7157",
      "title": "Confirma endereço de instalação",
      "blocks": [
        {
          "id": "01a19f46-3b11-74cc-b33b-b7bca75f1666",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "action": "Enviar botões",
            "buttons": [
              {
                "id": "01a19f46-3b11-74cc-b33b-b9f8d5692f86",
                "title": "Está certo ✅",
                "examples": [
                  "perfeito",
                  "isso",
                  "yes",
                  "ok",
                  "sim",
                  "certo"
                ],
                "outgoingEdgeId": "01a19f46-3b11-74cc-b33c-0d9a6ef1ee03"
              },
              {
                "id": "01a19f46-3b11-74cc-b33b-bf7649dabb3b",
                "title": "Está errado ❌",
                "examples": [
                  "nao",
                  "não",
                  "errado",
                  "incorreto",
                  "preciso corrigir"
                ],
                "outgoingEdgeId": "01a19f47-67bf-701c-98a1-7761008e7f66"
              }
            ],
            "channel": "{{channel}}",
            "bodyText": "Por favor, *confirme* se o endereço de instalação está correto:\n\n*Cep*: {{cep}}\n*Logradouro*: Rua {{logradouro}}\n*Número*: {{numEndereco}}\n*Complemento*: {{complemento}}\n*Bairro*: {{bairro}}\n*Cidade-UF*: {{cidade}} - {{uf}}",
            "awaitReply": true,
            "understandTypedReply": true
          }
        }
      ],
      "graphCoordinates": {
        "x": 261.50665771484364,
        "y": -353.29334228515614
      }
    },
