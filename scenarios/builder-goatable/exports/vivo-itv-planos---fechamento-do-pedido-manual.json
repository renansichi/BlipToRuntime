  "groups": [
    {
      "id": "01a19f36-1026-7440-97b3-db32c5df4e30",
      "title": "Confirma resumo do pedido",
      "blocks": [
        {
          "id": "01a19f36-1026-7440-97b3-d7ad22e167ce",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "action": "Enviar botões",
            "buttons": [
              {
                "id": "b1",
                "title": "Correto ✅",
                "examples": [
                  "certo",
                  "correto",
                  "isso",
                  "sim",
                  "yes"
                ],
                "outgoingEdgeId": "01a19f38-3c87-71ad-b0cc-a80a0263d26d"
              },
              {
                "id": "b2",
                "title": "Errado ❌",
                "examples": [
                  "errado",
                  "não",
                  "nao",
                  "incorreto",
                  "erro"
                ],
                "outgoingEdgeId": "01a19f38-3e6a-70fd-8c3d-bf6fe9b5b1d3"
              }
            ],
            "channel": "{{channel}}",
            "bodyText": "Esse é o resumo do seu pedido.\n\nEstá tudo correto?\n\nPlano: {{planName}} por {{price}}/mês",
            "awaitReply": true,
            "understandTypedReply": true
          }
        }
      ],
      "graphCoordinates": {
        "x": 261.50665771484364,
        "y": -353.29334228515614
      }
    },
    {
      "id": "01a19f36-19eb-73dc-b2a2-05747f33f166",
      "title": "Aceite dos termos",
      "blocks": [
        {
          "id": "01a19f36-19eb-73dc-b2a2-021eb17d5757",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "action": "Enviar botões",
            "buttons": [
              {
                "id": "b1",
                "title": "Aceito ✅",
                "examples": [
                  "aceito",
                  "ok",
                  "sim",
                  "concordo"
                ],
                "outgoingEdgeId": "01a19f38-404d-73e6-8835-73f5183b7828"
              },
              {
                "id": "b2",
                "title": "Discordo ❌",
                "examples": [
                  "não",
                  "nao",
                  "discordo"
                ],
                "outgoingEdgeId": "01a19f38-4231-732b-a025-e37c44627877"
              }
            ],
            "channel": "{{channel}}",
            "bodyText": "Para confirmar a sua assinatura, confira e aceite os termos abaixo: 📃\n\nLeia aqui: {{termo}}",
            "awaitReply": true,
            "understandTypedReply": true
          }
        }
      ],
      "graphCoordinates": {
        "x": 681.9866577148435,
        "y": -353.29334228515614
      }
    },
    {
      "id": "01a19f36-23ad-7118-a898-29dfca541df3",
      "title": "Termos recusados",
      "blocks": [
        {
          "id": "01a19f36-23ad-7118-a898-27f73b22eb13",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "action": "Enviar botões",
            "buttons": [
              {
                "id": "b1",
                "title": "Aceito ✅",
                "examples": [
                  "sim",
                  "aceito",
                  "ok",
                  "concordo"
                ],
                "outgoingEdgeId": "01a19f38-4414-7584-970e-581a34b993ee"
              },
              {
                "id": "b2",
                "title": "Não ❌",
                "examples": [
                  "não",
                  "nao",
                  "cancela",
                  "discordo"
                ],
                "outgoingEdgeId": "01a19f38-45f7-71e1-8dc6-0a418a33e0d4"
              }
            ],
            "channel": "{{channel}}",
            "bodyText": "Sem aceitar os Termos e Condições, não podemos finalizar sua compra.\n\nDeseja ler novamente?",
            "awaitReply": true,
            "understandTypedReply": true
          }
        }
      ],
      "graphCoordinates": {
        "x": 681.9866577148435,
        "y": 51.346657714843815
      }
    },
