              "url": "{{resource.blip.vivoitvplanos.apiurl}}",
              "body": "{\"acao\": \"concluido\", \"plano\": \"{{planName}}\", \"preco\": \"{{price}}\", \"telefone\": \"{{wa_id}}\"}",
              "method": "POST",
              "headers": []
