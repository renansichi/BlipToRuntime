  "groups": [
    {
      "id": "01a19f3d-8eb1-720e-851c-2df3825d0a6f",
      "title": "Confirma resumo do pedido",
      "blocks": [
        {
          "id": "01a19f3d-8eb2-770d-8a28-637e17ed9514",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "action": "Enviar botões",
            "buttons": [
              {
                "id": "b1",
                "title": "Confirmar",
                "examples": [
                  "confirmar",
                  "ok",
                  "sim",
                  "certo"
                ],
                "outgoingEdgeId": "01a19f3f-033c-728e-bacd-ce73d46aefb7"
              },
              {
                "id": "b2",
                "title": "Corrigir dados",
                "examples": [
                  "corrigir dados",
                  "erro",
                  "errado",
                  "alterar"
                ],
                "outgoingEdgeId": "01a19f3f-051f-77cc-a2ff-c867450219b3"
              }
            ],
            "channel": "{{channel}}",
            "bodyText": "{{resumo}}\n\n{{confirma}}",
            "awaitReply": true,
            "understandTypedReply": true
          }
        }
      ],
      "graphCoordinates": {
        "x": 261.50665771484364,
        "y": -353.29334228515614
      }
    },
    {
      "id": "01a19f3d-8eb2-770d-8a28-7dba0ebc260b",
      "title": "Pedido concluído",
      "blocks": [
        {
          "id": "01a19f3d-8eb2-770d-8a28-82a29a2540da",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "body": "Recebemos o seu pedido, o número dele é: {{idPedido}}!\n\nEm breve você receberá a confirmação da sua compra por aqui mesmo!\n\nObrigado por escolher a Vivo. 💜",
            "cards": [],
            "action": "Enviar texto",
            "buttons": [],
            "channel": "{{channel}}",
            "sections": []
          }
        },
        {
          "id": "01a19f3d-8eb2-770d-8a28-84c996943d85",
          "type": "endSession",
          "options": {}
        }
      ],
      "graphCoordinates": {
