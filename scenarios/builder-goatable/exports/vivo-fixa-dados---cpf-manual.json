  "groups": [
    {
      "id": "01a19f60-1261-73ff-89ba-8e4bc01d6129",
      "title": "Pede CPF",
      "blocks": [
        {
          "id": "01a19f60-1261-73ff-89ba-8bf64e0fb36e",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "body": "Perfeito! Informe, por gentileza, seu *CPF* completo (11 dígitos).\n\nExemplo: 123.456.789-09",
            "action": "Enviar texto",
            "channel": "{{channel}}",
            "awaitReply": true
          },
          "outgoingEdgeId": "01a19f61-9827-77ed-aec7-868f1595998b"
        }
      ],
      "graphCoordinates": {
        "x": 261.50665771484364,
        "y": -353.29334228515614
      }
    },
    {
      "id": "01a19f60-1c24-77aa-9c2b-1130ff90fb0d",
      "title": "Valida CPF",
      "blocks": [
        {
          "id": "01a19f60-1c24-77aa-9c2b-043203af6caa",
          "type": "Condition",
          "items": [
            {
              "id": "01a19f60-1c24-77aa-9c2b-0a1c31664f4d",
              "content": {
                "comparisons": [
                  {
                    "id": "01a19f60-1c24-77aa-9c2b-0e4e46fbc0ff",
                    "value": "^\\D*(\\d\\D*){11}$",
                    "variableId": "last_message",
                    "comparisonOperator": "Matches regex"
                  }
                ]
              },
              "outgoingEdgeId": "01a19f61-9a0a-721e-8d02-e9741e631c54"
            }
          ],
          "outgoingEdgeId": "01a19f61-9bee-77ca-bdab-d4db010e0344"
        }
      ],
      "graphCoordinates": {
        "x": 681.9866577148435,
        "y": -353.29334228515614
      }
    },
    {
      "id": "01a19f60-25ea-75f6-8a8d-c6c417f813ed",
      "title": "CPF inválido",
      "blocks": [
        {
          "id": "01a19f60-25ea-75f6-8a8d-c3de6f71866b",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "body": "O CPF foi digitado errado, ou está inválido. ❌\n\nPode digitar sem pontos que eu entendo. 😉\n\nLembre-se, o *CPF* tem 11 dígitos. Me informe novamente.",
            "action": "Enviar texto",
            "channel": "{{channel}}",
            "awaitReply": true
          },
          "outgoingEdgeId": "01a19f61-9dd1-75d6-8c58-1dd31db6871a"
        }
      ],
      "graphCoordinates": {
        "x": 681.9866577148435,
        "y": 116.14665771484381
      }
    },
    {
      "id": "01a19f60-2fac-77cd-be06-392c49261a9b",
      "title": "Erro ao consultar dados pessoais",
      "blocks": [
        {
          "id": "01a19f60-2fac-77cd-be06-356c301e42c1",
          "type": "whatsapp-cloud",
          "options": {
            "to": "{{wa_id}}",
            "body": "Hmm, aconteceu algum erro ao validar seus dados.\n\nPor favor digite de novo as informações a seguir:",
            "action": "Enviar texto",
            "channel": "{{channel}}"
          },
          "outgoingEdgeId": "01a19f61-a198-739c-81de-190f0b5a0676"
        }
      ],
      "graphCoordinates": {
        "x": 1135.5866577148436,
